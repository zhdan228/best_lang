fun digitChar(d: int32): string {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

fun intToStr(n: int32): string {
    if n == 0 { return "0"; }
    var s: string = "";
    var x: int32 = n;
    while x > 0 {
        s = digitChar(x % 10) + s;
        x = x / 10;
    }
    return s;
}

fun calculateAverage(grades: [int32; 100], count: int32): float64 {
    var sum: float64 = 0.0;
    var i: int32 = 0;
    while i < count {
        sum = sum + grades[i];
        i = i + 1;
    }
    return sum / count;
}

fun countExcellent(grades: [int32; 100], count: int32): int32 {
    var n: int32 = 0;
    var i: int32 = 0;
    while i < count {
        if grades[i] == 5 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fun countUnsatisfactory(grades: [int32; 100], count: int32): int32 {
    var n: int32 = 0;
    var i: int32 = 0;
    while i < count {
        if grades[i] == 2 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fun main(): int32 {
    var grades: [int32; 100];
    var count: int32 = 0;

    var g: int32 = input_int();
    while g != 0 {
        grades[count] = g;
        count = count + 1;
        g = input_int();
    }

    if count == 0 {
        print("Оценок нет");
        return 0;
    }

    val avg: float64      = calculateAverage(grades, count);
    val excellent: int32  = countExcellent(grades, count);
    val unsatis: int32    = countUnsatisfactory(grades, count);

    print("Средний балл:", end=" ");
    print(avg);
    print("Отличников: "  + intToStr(excellent));
    print("Двоечников: "  + intToStr(unsatis));

    if avg > 4.5 {
        print("Красный диплом");
    } else if unsatis > 0 {
        print("Отчисление");
    } else {
        print("Норма");
    }

    return 0;
}
